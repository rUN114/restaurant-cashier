# ============================================
# 密钥配置文件模板
# 1. 复制此文件为 application-secret.yml
# 2. 替换下面的占位符为真实密钥
# 3. application-secret.yml 不要提交到 Git！
# ============================================

# JWT 签名密钥（至少 32 字符，推荐 64 字符以上）
jwt:
  secret: ${JWT_SECRET:}
#  生成命令: openssl rand -base64 48

# 数据库密码（生产环境通过环境变量注入更安全）
spring:
  datasource:
    password: ${DB_PASSWORD:}

# DeepSeek AI API 配置
deepseek:
  api:
    key: ${DEEPSEEK_API_KEY:}
    url: https://api.deepseek.com/chat/completions
